DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pos_db?schema=public"
# Used only when creating the first administrator in an empty database.
POS_ADMIN_PASSWORD="CHANGE_ME"
# Optional absolute paths if PostgreSQL tools are not installed in their standard location:
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
# PG_RESTORE_PATH="C:/Program Files/PostgreSQL/18/bin/pg_restore.exe"
# Restoration only: a different, empty database (never the live POS database).
# RESTORE_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pos_recovery"

# Android API server. Use the same DATABASE_URL as the Electron administrator.
# Bind to the computer's LAN IP (or 0.0.0.0) to accept Android terminals.
POS_API_HOST="127.0.0.1"
POS_API_PORT="3210"
# Set a private random association code of at least 16 characters before starting.
POS_PAIRING_KEY=""
# Optional server identity and automatic backups directory:
# POS_DATA_DIR="E:/POS/server-data"
